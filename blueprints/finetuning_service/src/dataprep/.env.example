# MinIO/S3 Storage Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=dataprep
MINIO_SECURE=false
MINIO_REGION=us-east-1
MINIO_CERT_VERIFY=true

# API Configuration
HOST=0.0.0.0
PORT=8010

# CORS - comma-separated list of allowed origins (no wildcards when credentials=true)
# Example: http://localhost:3000,https://app.example.com
ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dataprep
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0

# Docling Configuration
DOCLING_NUM_THREADS=24

# LLM Configuration
MODEL_CONTEXT_WINDOW=32000

# QA Dataset Chunks Configuration
QA_PER_DATASET_CHUNKS=10

# Langfuse Import (/v1/langfuse/*)
LANGFUSE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TIMEOUT_SECONDS=60
LANGFUSE_MAX_TRACES_PER_IMPORT=10000
# Bounds the observation walk used to resolve which models have traces
LANGFUSE_MAX_OBSERVATIONS_PER_SCAN=5000

# GenAI Gateway (LiteLLM) - restricts the import model filter to deployed models.
# If unreachable, the filter falls back to every model seen in traces.
GENAI_GATEWAY_URL=http://localhost:4000
LITELLM_MASTER_KEY=
GENAI_GATEWAY_TIMEOUT_SECONDS=15
